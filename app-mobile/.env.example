# Copia questo file in ".env" (stessa cartella) e sostituisci i valori.
#   Mac / Linux:   cp .env.example .env
#   Windows (PowerShell):   Copy-Item .env.example .env
#
# ".env" NON va mai caricato su GitHub (è già nel .gitignore).
# I valori veri si chiedono all'altro studente in privato (non per email di gruppo, non in chat pubbliche).
# Dopo aver cambiato il file, riavvia con:  npx expo start --clear

# Indirizzo del progetto Supabase (Supabase > Project Settings > API > Project URL)
EXPO_PUBLIC_SUPABASE_URL=
# Chiave "anon" (Supabase > Project Settings > API). Mai la chiave "service_role"!
EXPO_PUBLIC_SUPABASE_ANON_KEY=
